# Copy this to ../.env (repo root) — config.py loads .env from the repo root
# specifically, not from code/. This copy lives here too just so it's visible
# right alongside the code that reads it; keep both in sync if you edit one.
#
#   cd code && cp .env.example ../.env
#
# Never commit the real .env (already gitignored).

# Required — primary provider for the LLM router and vision OCR.
GROQ_API_KEY=

# Optional but recommended — fallback provider, used only when Groq's
# free-tier daily quota is exhausted or a call fails after retries.
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is used if GEMINI_API_KEY is unset.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# All of the below have working defaults in code/config.py — only set these
# if you want to override the provider/model selection.
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# VISION_MODEL=qwen/qwen3.6-27b
# ASR_MODEL=whisper-large-v3
# VISION_FALLBACK_PROVIDER=google
# VISION_FALLBACK_MODEL=gemini-flash-lite-latest
# LLM_FALLBACK_PROVIDER=google
# LLM_FALLBACK_MODEL=gemini-flash-lite-latest
